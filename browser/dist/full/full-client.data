 along with OpenSpades.  If not, see <http://www.gnu.org/licenses/>.
 
 */


uniform sampler2D mainTexture;

varying vec2 texCoord;

uniform float gamma;

void main() {
	vec3 color;
	color = texture2D(mainTexture, texCoord).xyz;
	color = pow(color, vec3(gamma));
	gl_FragColor = vec4(color, 1.);
}

